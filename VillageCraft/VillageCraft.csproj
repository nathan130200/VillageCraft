<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.9</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="**/*Checks.cs;Checks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <Content Include="../mojangles.ttf" Condition="Exists('../mojangles.ttf')" Link="Content/Fonts/mojangles.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/**/*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/**/*.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/**/*.d.ts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/jsconfig.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/**/*.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/**/*.toml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <Target Name="RemoveObsoleteContent" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <ItemGroup>
      <ObsoleteContent Include="Professions/citizen.toml;Scripts/_ai.js;Scripts/animal.js;Scripts/villager.js;Scripts/guardian.js;Scripts/creeper.js;Scripts/melee.js;Scripts/ranged.js;Scripts/cat.js;Scripts/cats.js;Scripts/employment.js;Scripts/population.js;Scripts/building.js;Scripts/well.js;Prefabs/torch.toml;Prefabs/torch_workshop.toml;Models/torch.toml;Models/torch_flame.toml;Scripts/building_torch.js;Scripts/building_torch_workshop.js" />
    </ItemGroup>
    <Delete Files="@(ObsoleteContent->'$(OutDir)Content/%(Identity)')" />
    <Delete Files="@(ObsoleteContent->'$(PublishDir)Content/%(Identity)')" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>